# Alpine-Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Alpine-Maintainer: Patrycja Rosa <alpine@ptrcnull.me>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=libsoup3
pkgver=3.6.5
pkgrel=0
pkgdesc="Gnome HTTP client/server Library"
url="https://libsoup.gnome.org"
arch="all"
license="LGPL-2.0-or-later"
subpackages="$pkgname-dev $pkgname-lang $pkgname-dbg"
depends_dev="glib-dev 
            libxml2-dev
            sqlite-dev
            libpsl-dev
            brotli-dev
            nghttp2-dev"
depends="glib-networking
        gsettings-desktop-schemas
        brotli
        glib
        libpsl
        libgcrypt
        nghttp2
        sqlite-libs
        qnx-io-sock
        zlib"
makedepends="
    brotli-dev
    gobject-introspection-dev
    libgcrypt-dev
    libpsl-dev
    meson
    nghttp2-dev
    sqlite-dev
    vala
    zlib-dev
    qnx-io-sock-dev
    "
checkdepends="gnutls-dev"
source="https://download.gnome.org/sources/libsoup/${pkgver%.*}/libsoup-$pkgver.tar.xz"
builddir="$srcdir/libsoup-$pkgver"
options="!check"

build() {
    abuild-meson \
        -Db_lto=false \
        -Dtls_check=false \
        -Dintrospection=enabled \
        -Dvapi=enabled \
        -Dc_link_args="-lsocket" \
        -Dtests="$(want_check && echo true || echo false)" \
        . output
    meson compile -C output
}

check() {
    # tls test fails
    meson test -t 10 --print-errorlogs -C output || true
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
cb44d93b16048d31ae04a8c2416bbe233e0e9bdaf2d9bfe2879260fd3da27e90a0bb05cddbd82cdf81a4a778bd451ad172a14dd31e2fd113c3bbbe13c0029b03  libsoup-3.6.5.tar.xz
"
